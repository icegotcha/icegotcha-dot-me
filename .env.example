# Copy to .env.development for pnpm dev, or .env.production for build/start.
# See README.md for official Cloudflare and Resend testing setup. Never commit real credentials.
# Create a managed Turnstile widget and allow your site's domain (localhost for development).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional additional server-side hostname check, e.g. icegotcha.me (no scheme).
TURNSTILE_EXPECTED_HOSTNAME=

# Resend API key and a sender on your verified Resend domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=hello@icegotcha.me
